{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto-pigeon.org/schemas/apmap/1.1/apmap.schema.json",
  "title": "APMap 1.1 geometry document",
  "description": "One APMap document is one geometry document or one prefab geometry layer. Package classification, behaviour, validation, recipes and review evidence stay in their existing sidecars. 1.1 is strictly additive over 1.0: it adds the derived_from kind 'operation' and the optional brush member 'broken', and changes nothing else, so every valid 1.0 document is a valid 1.1 document. This schema validates both; a document declaring apmap_version '1.0' is held to the frozen 1.0 contract by apmap-1.0.schema.json, which is preserved beside this file for converters and archived documents.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apmap_version",
    "document_id",
    "revision",
    "role",
    "game",
    "map_dialect",
    "id_policy",
    "frame",
    "entities"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "apmap_version": {
      "description": "The contract this document is written against. 1.1 accepts a 1.0 document unchanged; a producer declares 1.1 only once it writes something 1.0 has no place for.",
      "enum": [
        "1.0",
        "1.1"
      ]
    },
    "document_id": {
      "$ref": "#/$defs/document_id"
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "role": {
      "enum": [
        "full_map",
        "prefab_core",
        "reference_context",
        "cropped_context"
      ]
    },
    "game": {
      "$ref": "#/$defs/registry_name"
    },
    "map_dialect": {
      "$ref": "#/$defs/registry_name"
    },
    "id_policy": {
      "enum": [
        "derived",
        "minted"
      ]
    },
    "frame": {
      "$ref": "#/$defs/frame"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "entities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entity"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationship"
      }
    },
    "extensions": {
      "$ref": "#/$defs/extensions"
    }
  },
  "$defs": {
    "document_id": {
      "type": "string",
      "pattern": "^[0-9A-Za-z][0-9A-Za-z._:-]{0,127}$"
    },
    "entity_id": {
      "type": "string",
      "pattern": "^ent_[0-9A-Za-z]{8,64}$"
    },
    "brush_id": {
      "type": "string",
      "pattern": "^brs_[0-9A-Za-z]{8,64}$"
    },
    "face_id": {
      "type": "string",
      "pattern": "^fac_[0-9A-Za-z]{8,64}$"
    },
    "object_id": {
      "type": "string",
      "pattern": "^(ent|brs|fac)_[0-9A-Za-z]{8,64}$"
    },
    "registry_name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "finite_number": {
      "description": "JSON numbers only. NaN, Infinity and -Infinity are forbidden by rule SEM-11; JSON Schema cannot express that constraint, so a semantic validator must enforce it.",
      "type": "number"
    },
    "vec2": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/finite_number"
      }
    },
    "vec3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/finite_number"
      }
    },
    "vec4": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/finite_number"
      }
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "$ref": "#/$defs/vec3"
        },
        "max": {
          "$ref": "#/$defs/vec3"
        }
      }
    },
    "map_string": {
      "description": "A MAP key or value. The MAP writer cannot quote a raw double quote, a carriage return or a line feed.",
      "type": "string",
      "pattern": "^[^\"\\r\\n]*$"
    },
    "transform": {
      "description": "APMap 1.0 permits identity and translation only. The name 'affine' is reserved for a later version and is rejected here.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "identity"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "translation"
          ],
          "properties": {
            "type": {
              "const": "translation"
            },
            "translation": {
              "$ref": "#/$defs/vec3"
            }
          }
        }
      ]
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "space",
        "units",
        "to_source"
      ],
      "properties": {
        "space": {
          "enum": [
            "source_world",
            "prefab_local"
          ]
        },
        "units": {
          "const": "quake_unit"
        },
        "coordinate_system": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "handedness",
            "up_axis"
          ],
          "properties": {
            "handedness": {
              "const": "right"
            },
            "up_axis": {
              "const": "z"
            }
          }
        },
        "to_source": {
          "$ref": "#/$defs/transform"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer",
        "producer_version"
      ],
      "properties": {
        "producer": {
          "type": "string",
          "minLength": 1
        },
        "producer_version": {
          "type": "string",
          "minLength": 1
        },
        "pipeline": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "map_name": {
              "type": "string",
              "minLength": 1
            },
            "map_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "corpus": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "package": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "package_id": {
              "type": "string",
              "minLength": 1
            },
            "role_file": {
              "type": "string",
              "minLength": 1
            },
            "revision": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "generated_at": {
          "description": "Wall-clock time. Including it forfeits byte-for-byte determinism (rule SER-8); omit it in any document that must be reproducible.",
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "derived_from": {
      "oneOf": [
        {
          "$ref": "#/$defs/derived_from_source_map"
        },
        {
          "$ref": "#/$defs/derived_from_package"
        },
        {
          "$ref": "#/$defs/derived_from_authored"
        },
        {
          "$ref": "#/$defs/derived_from_synthetic"
        },
        {
          "$ref": "#/$defs/derived_from_operation"
        }
      ]
    },
    "derived_from_package": {
      "description": "Geometry published as part of a named package, where the package id and the object's path inside this document are the stable semantic identity. Only package_id, role and object_path contribute to the derived id; every other member is provenance.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "package_id",
        "role",
        "object_path"
      ],
      "properties": {
        "kind": {
          "const": "package"
        },
        "package_id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "full_map",
            "prefab_core",
            "reference_context",
            "cropped_context"
          ]
        },
        "object_path": {
          "type": "string",
          "pattern": "^e[0-9]+(\\.b[0-9]+(\\.f[0-9]+)?)?$"
        },
        "source_map": {
          "type": "string",
          "minLength": 1
        },
        "source_entity_index": {
          "type": "integer",
          "minimum": 0
        },
        "source_brush_position": {
          "type": "integer",
          "minimum": 0
        },
        "origin_at_extraction": {
          "$ref": "#/$defs/vec3"
        },
        "bounds_at_extraction": {
          "$ref": "#/$defs/bounds"
        }
      }
    },
    "derived_from_source_map": {
      "description": "Geometry imported or extracted from a MAP file. Only source_map, source_sha256 and source_path contribute to the derived id; every other member is provenance and may change without changing identity.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "source_path"
      ],
      "properties": {
        "kind": {
          "const": "source_map"
        },
        "source_map": {
          "type": "string",
          "minLength": 1
        },
        "source_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_path": {
          "type": "string",
          "pattern": "^e[0-9]+(\\.b[0-9]+(\\.f[0-9]+)?)?$"
        },
        "source_entity_index": {
          "type": "integer",
          "minimum": 0
        },
        "source_brush_position": {
          "type": "integer",
          "minimum": 0
        },
        "origin_at_extraction": {
          "$ref": "#/$defs/vec3"
        },
        "bounds_at_extraction": {
          "$ref": "#/$defs/bounds"
        }
      }
    },
    "derived_from_authored": {
      "description": "Geometry created by a user operation. The identity inputs are document_id, operation_id and ordinal, so replaying an operation journal reproduces the same ids.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "document_id",
        "operation_id",
        "ordinal"
      ],
      "properties": {
        "kind": {
          "const": "authored"
        },
        "document_id": {
          "$ref": "#/$defs/document_id"
        },
        "operation_id": {
          "type": "string",
          "minLength": 1
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "derived_from_operation": {
      "description": "Geometry that exists because a user operation rewrote or replaced an earlier object. New in 1.1. This is what keeps provenance truthful after an edit: an object whose geometry an operation changed can no longer honestly claim a source-map location, because the geometry no longer matches what is at that location. It says instead 'this object exists because operation X replaced its ancestor'. Distinct from kind 'authored', which records an object the operation *created* and whose identity is derived from document_id, operation_id and ordinal; 'operation' records an object that *supersedes* one that was already there, and names it in `replaces`.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "operation_id"
      ],
      "properties": {
        "kind": {
          "const": "operation"
        },
        "operation_id": {
          "description": "The operation that produced this object. The one member beyond `kind` that is always present: without it the record names no cause and is worth no more than the false source-map record it replaced.",
          "type": "string",
          "minLength": 1
        },
        "operation": {
          "description": "What kind of operation it was, as a registry name, e.g. csg_carve.",
          "$ref": "#/$defs/registry_name"
        },
        "ordinal": {
          "description": "Position of this object among those the operation produced, so replaying an operation journal is deterministic.",
          "type": "integer",
          "minimum": 0
        },
        "replaces": {
          "description": "The objects this one supersedes, by id. Usually one; a merge names several. Absent when the operation rewrote an object in place and the id did not change.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/object_id"
          }
        },
        "intent": {
          "description": "Free text recording what the operation was for, e.g. 'carve a doorway'. **Annotation, never authorization.** No consumer may read this field to decide whether an operation was permitted, what it is allowed to touch, or how to re-apply it: it is written by whoever ran the operation, it is not validated against what the operation actually did, and a document is not a trusted channel. It exists so a human reading provenance months later can tell why the geometry changed.",
          "type": "string"
        },
        "metadata": {
          "description": "Further annotation about the operation, on the same terms as `intent`: descriptive only, never consulted to authorize anything. Kept open so a producer need not invent an `extensions` namespace for a note.",
          "type": "object"
        }
      }
    },
    "derived_from_synthetic": {
      "description": "Geometry invented by a deterministic generator, such as a context-crop cap face.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "generator"
      ],
      "properties": {
        "kind": {
          "const": "synthetic"
        },
        "generator": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "$ref": "#/$defs/registry_name"
        },
        "source_object": {
          "$ref": "#/$defs/object_id"
        },
        "parameters": {
          "type": "object"
        }
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_id",
        "content"
      ],
      "properties": {
        "entity_id": {
          "$ref": "#/$defs/entity_id"
        },
        "derived_from": {
          "$ref": "#/$defs/derived_from"
        },
        "content": {
          "description": "Properties and brushes in authored order. Repeated keys are legal and their relative position is significant.",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/content_item"
          }
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      }
    },
    "content_item": {
      "oneOf": [
        {
          "$ref": "#/$defs/property_item"
        },
        {
          "$ref": "#/$defs/brush_item"
        }
      ]
    },
    "property_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "key",
        "value"
      ],
      "properties": {
        "kind": {
          "const": "property"
        },
        "key": {
          "$ref": "#/$defs/map_string"
        },
        "value": {
          "$ref": "#/$defs/map_string"
        }
      }
    },
    "brush_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "brush_id",
        "faces"
      ],
      "properties": {
        "kind": {
          "const": "brush"
        },
        "brush_id": {
          "$ref": "#/$defs/brush_id"
        },
        "derived_from": {
          "$ref": "#/$defs/derived_from"
        },
        "faces": {
          "description": "A bounded convex solid needs at least four half-spaces. Boundedness and convexity are semantic rules SEM-6 and SEM-7.",
          "type": "array",
          "minItems": 4,
          "items": {
            "$ref": "#/$defs/face"
          }
        },
        "broken": {
          "description": "The brush is known not to be a well-formed convex solid, and is kept anyway. New in 1.1. Absent means false; there is no third state. A CSG repair that fails leaves a result the user may choose to keep, and a level in that condition is ordinary work in progress, not a fault to be corrected on the user's behalf — nothing may refuse to load, repair, or drop a brush because this flag is set. It crosses the wire in collaborative sessions and survives Save. Export to .map warns and exports anyway; that behaviour belongs to exporters rather than to this schema, and is stated here so implementers inherit the intent rather than each inventing one. Setting the flag is not itself a validation result: this schema never requires it to be present on a brush that is in fact broken, because nothing here validates geometry on its own.",
          "type": "boolean"
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      }
    },
    "face": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "face_id",
        "plane",
        "texture",
        "projection"
      ],
      "properties": {
        "face_id": {
          "$ref": "#/$defs/face_id"
        },
        "derived_from": {
          "$ref": "#/$defs/derived_from"
        },
        "plane": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "points"
          ],
          "properties": {
            "points": {
              "description": "Exactly three points, in MAP order. The plane normal and the solid side follow the source dialect's winding convention.",
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "$ref": "#/$defs/vec3"
              }
            }
          }
        },
        "texture": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\s\"]+$"
        },
        "projection": {
          "$ref": "#/$defs/projection"
        },
        "tail": {
          "description": "Quake 2-style trailing numeric face values, preserved verbatim and uninterpreted in 1.0.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/finite_number"
          }
        },
        "synthetic": {
          "type": "boolean"
        },
        "synthetic_reason": {
          "$ref": "#/$defs/registry_name"
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      }
    },
    "projection": {
      "oneOf": [
        {
          "$ref": "#/$defs/projection_classic"
        },
        {
          "$ref": "#/$defs/projection_valve220"
        }
      ]
    },
    "projection_classic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "shift",
        "rotation",
        "scale"
      ],
      "properties": {
        "mode": {
          "const": "classic"
        },
        "shift": {
          "$ref": "#/$defs/vec2"
        },
        "rotation": {
          "$ref": "#/$defs/finite_number"
        },
        "scale": {
          "$ref": "#/$defs/vec2"
        }
      }
    },
    "projection_valve220": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "u_axis",
        "v_axis",
        "rotation",
        "scale"
      ],
      "properties": {
        "mode": {
          "const": "valve220"
        },
        "u_axis": {
          "description": "[x, y, z, shift].",
          "$ref": "#/$defs/vec4"
        },
        "v_axis": {
          "description": "[x, y, z, shift].",
          "$ref": "#/$defs/vec4"
        },
        "rotation": {
          "$ref": "#/$defs/finite_number"
        },
        "scale": {
          "$ref": "#/$defs/vec2"
        }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "from",
        "to"
      ],
      "properties": {
        "relationship_id": {
          "type": "string",
          "pattern": "^rel_[0-9A-Za-z]{8,64}$"
        },
        "type": {
          "$ref": "#/$defs/registry_name"
        },
        "from": {
          "$ref": "#/$defs/object_id"
        },
        "to": {
          "$ref": "#/$defs/object_id"
        },
        "payload": {
          "type": "object"
        }
      }
    },
    "extensions": {
      "description": "Namespaced vendor data. A namespace must contain at least one dot, so a producer can never claim a bare word.",
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9-]*(\\.[a-z0-9][a-z0-9_-]*)+$"
      },
      "additionalProperties": {
        "type": "object"
      }
    }
  }
}
