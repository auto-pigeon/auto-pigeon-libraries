{
  "$schema": "./auto-pigeon-workspace.schema.json",
  "schema_version": "1.0",
  "description": "The repositories that make up an Auto-Pigeon workspace. Topology only: no machine paths, no data-root paths, no ports, no secrets.",
  "repositories": [
    {
      "alias": "AUP",
      "directory": "auto-pigeon",
      "repository_name": "auto-pigeon-editor",
      "clone_url": "https://github.com/auto-pigeon/auto-pigeon-editor.git",
      "role": "Editor frontend and local workbench server."
    },
    {
      "alias": "AUB",
      "directory": "auto-pigeon-backend",
      "clone_url": "https://github.com/auto-pigeon/auto-pigeon-backend.git",
      "role": "Durable cloud state: accounts, maps, assets, definitions."
    },
    {
      "alias": "AUC",
      "directory": "auto-pigeon-collaboration",
      "clone_url": "https://github.com/auto-pigeon/auto-pigeon-collaboration.git",
      "role": "Realtime collaboration: rooms, leases, journal."
    },
    {
      "alias": "AUCOM",
      "directory": "auto-pigeon-companion",
      "clone_url": "https://github.com/auto-pigeon/auto-pigeon-companion.git",
      "role": "Companion desktop application: local profiles, toolchains, builds and engine launches."
    },
    {
      "alias": "AUE",
      "directory": "auto-pigeon-extractor",
      "clone_url": "https://github.com/auto-pigeon/auto-pigeon-extractor.git",
      "role": "Extraction, format conversion and normalization."
    },
    {
      "alias": "AUG",
      "directory": "auto-pigeon-gallery",
      "clone_url": "https://github.com/auto-pigeon/auto-pigeon-gallery.git",
      "role": "Gallery and public presentation."
    },
    {
      "alias": "AUT",
      "directory": "auto-pigeon-tools",
      "clone_url": "https://github.com/auto-pigeon/auto-pigeon-tools.git",
      "role": "Workspace tooling: launcher, agent task runner, clone and pull scripts."
    },
    {
      "alias": "AULIBS",
      "directory": "auto-pigeon-libraries",
      "clone_url": "https://github.com/auto-pigeon/auto-pigeon-libraries.git",
      "role": "Shared libraries and canonical contracts. Holds this manifest and the APMap schema."
    },
    {
      "alias": "TEL",
      "directory": "auto-pigeon-telemetry",
      "clone_url": "https://github.com/auto-pigeon/auto-pigeon-telemetry.git",
      "role": "Deployment of the third-party observability software: GlitchTip, its PostgreSQL, Gatus."
    },
    {
      "alias": "ERICW",
      "directory": "ericw-tools",
      "clone_url": "https://github.com/auto-pigeon/ericw-tools.git",
      "role": "The Auto-Pigeon fork of ericw-tools: the Quake map compilers (qbsp, vis, light) the pinned releases are built from."
    }
  ]
}
